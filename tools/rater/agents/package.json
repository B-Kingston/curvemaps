{
  "name": "curvemaps-rater-agents",
  "private": true,
  "type": "module",
  "description": "pi agents review rater plans with rendered maps; see tools/rater/README.md",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "playwright-core install chromium --no-shell",
    "check": "node agents.mjs --check",
    "review": "node agents.mjs",
    "sweep": "node sweep.mjs",
    "digest": "node digest.mjs",
    "compare": "node compare.mjs",
    "test": "node --test sweep.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "maplibre-gl": "5.24.0",
    "playwright-core": "1.63.0",
    "pmtiles": "4.5.0",
    "typebox": "1.3.27"
  }
}
